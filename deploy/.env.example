# 复制为 .env 并改掉全部值；.env 不得入库。
# 对外域名（A 记录指向本 VPS；caddy 据此签发证书，coturn 用作 realm）。
RDX_DOMAIN=rdx.example.com

# TURN REST 凭证共享密钥：openssl rand -hex 32。
# rd-server 签发、coturn 校验，两者必须一致；轮换步骤见 README。
RDX_TURN_SECRET=change-me-32-bytes-hex

# Postgres（v1-dev 仅预留，未接 rd-server）。
RDX_POSTGRES_PASSWORD=change-me
